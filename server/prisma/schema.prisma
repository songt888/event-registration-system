// System SDS 2.1. Raw SQL in the first migration adds what Prisma 5 cannot declare:
// the capacity CHECK 1..10000 (D-03) and the ACTIVE partial unique index (D-02).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum RegistrationStatus {
  ACTIVE
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  name          String
  passwordHash  String
  role          Role
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  sessions      Session[]
  events        Event[]
  registrations Registration[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
}

model Event {
  id            String         @id @default(uuid()) @db.Uuid
  ownerId       String         @db.Uuid
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title         String         @db.VarChar(120)
  description   String         @default("") @db.VarChar(2000)
  location      String         @db.VarChar(120)
  startsAt      DateTime       @db.Timestamptz(3)
  capacity      Int
  status        EventStatus    @default(DRAFT)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?      @db.Timestamptz(3)
  registrations Registration[]
}

model Registration {
  id            String             @id @default(uuid()) @db.Uuid
  eventId       String             @db.Uuid
  event         Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  participantId String             @db.Uuid
  participant   User               @relation(fields: [participantId], references: [id], onDelete: Restrict)
  status        RegistrationStatus @default(ACTIVE)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)

  @@index([eventId, status])
}
